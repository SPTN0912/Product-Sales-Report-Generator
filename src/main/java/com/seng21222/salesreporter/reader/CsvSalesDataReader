package com.seng21222.salesreporter.reader;

import com.seng21222.salesreporter.exception.CsvFileNotFoundException;
import com.seng21222.salesreporter.exception.InvalidCsvRowException;
import com.seng21222.salesreporter.model.Product;

import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.List;


public class CsvSalesDataReader implements SalesDataReader {

    private static final int EXPECTED_COLUMN_COUNT = 5;
    private static final String DELIMITER = ",";

    @Override
    public List<Product> readData(String sourcePath)
            throws CsvFileNotFoundException, InvalidCsvRowException {

        Path path = Path.of(sourcePath);
        if (!Files.exists(path) || !Files.isRegularFile(path)) {
            throw new CsvFileNotFoundException(sourcePath);
        }

        List<Product> products = new ArrayList<>();

        try (BufferedReader reader = new BufferedReader(new FileReader(sourcePath))) {
            String line;
            int lineNumber = 0;
            boolean headerSkipped = false;

            while ((line = reader.readLine()) != null) {
                lineNumber++;

                if (line.isBlank()) {
                    continue;
                }

                if (!headerSkipped) {
                    // The assignment says the CSV "may" have a header row.
                    // We detect it by checking whether the first field on
                    // line 1 parses as a number; if it doesn't, it's a header.
                    if (isHeaderRow(line)) {
                        headerSkipped = true;
                        continue;
                    }
                    headerSkipped = true; // no header present; fall through and parse this row
                }

                products.add(parseLine(line, lineNumber));
            }
        } catch (IOException e) {
            throw new CsvFileNotFoundException(sourcePath);
        }

        return products;
    }

    private boolean isHeaderRow(String line) {
        String[] fields = line.split(DELIMITER);
        if (fields.length == 0) {
            return true;
        }
        // Column 4 (index 3) should be an integer quantity for a real data row.
        if (fields.length < EXPECTED_COLUMN_COUNT) {
            return true;
        }
        try {
            Integer.parseInt(fields[3].trim());
            return false; // parsed fine -> this is a data row, not a header
        } catch (NumberFormatException e) {
            return true; // not numeric -> treat as header
        }
    }

    private Product parseLine(String line, int lineNumber) throws InvalidCsvRowException {
        String[] fields = line.split(DELIMITER, -1);

        if (fields.length < EXPECTED_COLUMN_COUNT) {
            throw new InvalidCsvRowException(lineNumber,
                    "expected " + EXPECTED_COLUMN_COUNT + " columns but found " + fields.length);
        }

        try {
            String productId = fields[0].trim();
            String productName = fields[1].trim();
            String category = fields[2].trim();
            int quantitySold = Integer.parseInt(fields[3].trim());
            double unitPrice = Double.parseDouble(fields[4].trim());

            if (productId.isEmpty() || productName.isEmpty() || category.isEmpty()) {
                throw new InvalidCsvRowException(lineNumber, "one or more required text fields is empty");
            }

            return new Product(productId, productName, category, quantitySold, unitPrice);
        } catch (NumberFormatException e) {
            throw new InvalidCsvRowException(lineNumber, "quantity_sold/unit_price is not numeric");
        }
    }
}
